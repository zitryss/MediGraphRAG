  "info": {
    "description": "Turn unstructured documents into schema-consistent knowledge graphs. Query them with hybrid vector + graph RAG. Measure answer confidence with output, grounding, and structural diagnostics.",
    "title": "OntographRAG",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
