              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/bulk_process_csv": {
      "post": {
        "description": "Process documents from any CSV in bulk batches, guided by the loaded ontology.\n\nThe ontology defines what entities and relationships to extract.\nOnly `text_column` needs to match a column in your CSV.",
