    },
    "/clear_kg": {
      "post": {
        "description": "Delete a knowledge graph from Neo4j.\n\nWhen *kg_name* is provided, only nodes (``__Entity__`` and ``Document``)\nwhose ``kgName`` property matches are removed together with their\nrelationships.  When omitted, the entire database is wiped (all nodes,\nrelationships, constraints, and indexes).",
        "operationId": "clear_kg_clear_kg_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
